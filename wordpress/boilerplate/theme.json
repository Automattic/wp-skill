{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base",      "color": "#ffffff", "name": "Base" },
        { "slug": "contrast",  "color": "#1a1a1a", "name": "Contrast" },
        { "slug": "primary",   "color": "#2b2b2b", "name": "Primary" },
        { "slug": "secondary", "color": "#555555", "name": "Secondary" },
        { "slug": "accent",    "color": "#6e4423", "name": "Accent" },
        { "slug": "surface",   "color": "#f2efe9", "name": "Surface" },
        { "slug": "border",    "color": "#dcd6cc", "name": "Border" },
        { "slug": "muted",     "color": "#6b6b6b", "name": "Muted" }
      ]
    },
    "typography": {
      "fluid": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        { "slug": "heading", "name": "Heading", "fontFamily": "Georgia, 'Times New Roman', serif" },
        { "slug": "body",    "name": "Body",    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small",   "size": "0.875rem",  "name": "Small" },
        { "slug": "medium",  "size": "1.0625rem", "name": "Medium" },
        { "slug": "large",   "size": "1.25rem",   "name": "Large" },
        { "slug": "x-large", "size": "clamp(1.6rem, 1.25rem + 1.4vw, 2.125rem)", "name": "Extra Large" },
        { "slug": "huge",    "size": "clamp(2.25rem, 1.6rem + 2.8vw, 3.25rem)", "name": "Huge" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": { "steps": 7 }
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "clamp(1.5rem, 5vw, 4rem)",
        "right": "clamp(1.5rem, 5vw, 4rem)"
      }
    },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var:preset|font-family|heading", "lineHeight": "1.2" },
        "color": { "text": "var:preset|color|primary" }
      },
      "link": {
        "color": { "text": "var:preset|color|accent" },
        ":hover": { "color": { "text": "var:preset|color|primary" } }
      }
    },
    "blocks": {
      "core/navigation":    { "spacing": { "blockGap": "var:preset|spacing|30" } },
      "core/buttons":       { "spacing": { "blockGap": "var:preset|spacing|30" } },
      "core/post-template": { "spacing": { "blockGap": "var:preset|spacing|50" } },
      "core/query":         { "spacing": { "blockGap": "var:preset|spacing|50" } },
      "core/columns":       { "spacing": { "blockGap": "var:preset|spacing|40" } },
      "core/button": {
        "color": { "background": "var:preset|color|accent", "text": "var:preset|color|base" },
        "spacing": { "padding": { "top": "var:preset|spacing|20", "bottom": "var:preset|spacing|20", "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" } },
        ":hover": { "color": { "background": "var:preset|color|primary", "text": "var:preset|color|base" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
